# Mobile env. EAS bakes EXPO_PUBLIC_* values from eas.json's `env` block at
# build time, so these only matter for local `expo start`.
#
# Anthropic key is NOT here — Claude calls go through aspera-web's
# /api/mobile/claude proxy (server-side). The mobile app only ships a
# bearer secret rotatable independently.

EXPO_PUBLIC_API_URL=https://your-aspera-web.vercel.app
EXPO_PUBLIC_MOBILE_API_SECRET=hex-secret-shared-with-aspera-web-MOBILE_API_SECRET
