{
  "expo": {
    "name": "Aspera",
    "slug": "aspera",
    "version": "1.2.0",
    "scheme": "aspera",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#090C14"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dominicross.aspera",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.family-controls": true,
        "com.apple.security.application-groups": [
          "group.com.dominicross.aspera"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#090C14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dominicross.aspera"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6C63FF",
          "sounds": []
        }
      ],
      "expo-apple-authentication",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": "1.2.0",
    "updates": {
      "url": "https://u.expo.dev/e01ca167-89c8-420c-a7ab-37e02e92a28a",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e01ca167-89c8-420c-a7ab-37e02e92a28a",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "DeviceActivityMonitorExtension",
                  "bundleIdentifier": "com.dominicross.aspera.DeviceActivityMonitorExtension",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.dominicross.aspera"
                    ]
                  }
                },
                {
                  "targetName": "DeviceActivityReportExtension",
                  "bundleIdentifier": "com.dominicross.aspera.DeviceActivityReportExtension",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.dominicross.aspera"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
