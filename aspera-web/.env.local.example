# Anthropic — server-side Claude API key (never exposed to client)
CLAUDE_KEY=sk-ant-api03-your-key-here

# Supabase — project "aspera" (ref: epfewtmwfpnbkwxcnohb, region us-east-1)
# Fetch current keys via `npx supabase keys --project-ref epfewtmwfpnbkwxcnohb`
# or the Supabase MCP `get_publishable_keys`.
NEXT_PUBLIC_SUPABASE_URL=https://epfewtmwfpnbkwxcnohb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_FiqQktd3AKrPhjBfMhMW5w_JpQ_Mt5v
SUPABASE_SERVICE_ROLE_KEY=  # paste from Supabase dashboard → Project Settings → API

# Expo push — used by /api/push/cron to authenticate Vercel cron invocations
CRON_SECRET=  # generate with: openssl rand -hex 32

# Chrome extension shared secret — validated by /api/browsing
# Extension sets this in chrome.storage.local; server compares against env var.
EXTENSION_SHARED_SECRET=  # generate with: openssl rand -hex 32
